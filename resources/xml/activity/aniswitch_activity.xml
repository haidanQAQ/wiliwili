<brls:AppletFrame
        iconInterpolation="linear"
        headerHidden="true"
        footerHidden="false">
    <brls:Box
            axis="column"
            grow="1">
        <brls:Label
                fontSize="26"
                marginLeft="24"
                marginTop="16"
                marginBottom="10"
                text="AniSwitch 网络播放"/>

        <brls:Label
                id="aniswitch/status"
                fontSize="18"
                marginLeft="24"
                marginRight="24"
                marginBottom="8"
                text=""/>

        <RecyclingGrid
                id="aniswitch/grid"
                paddingLeft="24"
                paddingRight="24"
                itemHeight="80"
                grow="1"
                preFetchLine="2"
                spanCount="1"
                wireframe="false"/>

        <ButtonClose
                positionType="absolute"
                positionTop="10"
                positionRight="10"/>
    </brls:Box>
</brls:AppletFrame>
