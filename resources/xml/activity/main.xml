<brls:AppletFrame
        iconInterpolation="linear"
        headerHidden="true"
        footerHidden="false">
    <brls:Box
            axis="column"
            width="100%"
            height="100%"
            justifyContent="center"
            alignItems="center">

        <!-- 唯一入口：AniSwitch（WebDAV 播放 + 弹幕） -->
        <CustomButton
                id="main/aniswitch"
                focusable="true"
                width="240"
                height="240"
                highlightCornerRadius="28"
                cornerRadius="28"
                wireframe="false">
            <SVGImage
                    width="132"
                    height="132"
                    SVG="@res/svg/ico-aniswitch.svg"/>
        </CustomButton>

        <brls:Label
                marginTop="24"
                fontSize="34"
                text="AniSwitch"/>
    </brls:Box>
</brls:AppletFrame>
